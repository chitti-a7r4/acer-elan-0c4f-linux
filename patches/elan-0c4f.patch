@@ -419,7 +420,19 @@ capture_run_state (FpiSsm *ssm, FpDevice *dev)
       break;
 
     case CAPTURE_GET_IMAGE:
-      if (self->last_read[0] != 0x55)
+      if (self->last_read[0] == 0xaf)
+        {
+          /* Firmware 0165 can report 0xaf between usable frames. Only

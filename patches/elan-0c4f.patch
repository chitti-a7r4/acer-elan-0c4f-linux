@@ -69,6 +69,7 @@ static const ElanOemCmd get_sensor_dim_cmd = { { 0x00, 0x0c }, EP_CMD_IN, 4 };
 static const ElanOemCmd get_image_cmd = { { 0x00, 0x09 }, EP_IMG_IN, FRAME_SIZE * 2 };
